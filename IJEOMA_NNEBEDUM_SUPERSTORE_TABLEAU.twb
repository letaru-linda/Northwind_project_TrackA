      </column>
      <column caption='Shipping Status' datatype='string' name='[Calculation_0570930471153664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Days_to_Ship] &lt;= 4 THEN &quot;On Tim&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='Profit Margin%' datatype='real' name='[Calculation_0759496406097920]' role='measure' type='quantitative'>
