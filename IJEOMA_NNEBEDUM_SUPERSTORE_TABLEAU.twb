              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Order_Date]' derivation='Year' name='[yr:Order_Date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0wt0wbq0h1f5od131h4sz0xtgfsv].[none:Market:nk]</column>
            <column>[federated.0wt0wbq0h1f5od131h4sz0xtgfsv].[none:Sub_Category:nk]</column>
